# Server-only. Do not add the NEXT_PUBLIC_ prefix (D5-a)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional. If omitted, API routes use the oldest onboarded demo user.
DEMO_USER_ID=

# Fixed demo date (D11). Leave empty to use the real KST date
DEMO_TODAY=2026-09-01

# 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
