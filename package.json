{
  "name": "goreuge-shared",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "npm run build && node dist/test/smoke.js",
    "engine-verify": "npm run build && node dist/test/engine-verify.js",
    "verify": "npm run typecheck && npm run build && node dist/test/smoke.js && node dist/test/engine-verify.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}